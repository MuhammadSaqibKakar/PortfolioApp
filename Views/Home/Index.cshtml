@{
    ViewData["Title"] = "Home";
}

<div class="hero position-relative d-flex"
    style="min-height:100vh; background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); overflow:hidden;">

    <!-- Main Text (Top-Left) -->
    <div class="mainn-text position-absolute" style="top: 20%; left: 5%; max-width: 70vw;">
        <h1 class="fw-bold text-white mb-3" style="font-family:'Poppins', sans-serif; font-size:8vw; line-height:1.2;">
            Hi, I'm Saqib
        </h1>
        <p class="mb-3" style="font-size:2.5vw; color: #ffd942;">
            Full-Stack Developer | .NET | C# | Cloud | Linux
        </p>
    </div>
    @* <div>
      <h1 class="fw-bold text-white mb-3" style="font-family:'Poppins', sans-serif; font-size:8vw; line-height:1.2;">
            Hi, I'm Saqib
        </h1>
        <p class="mb-3" style="font-size:2.5vw; color: #ffd942;">
            Full-Stack Developer | .NET | C# | Cloud | Linux
        </p>
    </div> *@

    <!-- Skills + Button (Bottom-Right) -->
    <div class="skills-button position-absolute d-flex flex-column align-items-end"
        style="bottom: 20%; right: 5%; max-width: 50%;">
        <div class="d-flex flex-wrap justify-content-end">
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">C#</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">ASP.NET Core</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">Entity Framework</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">Bootstrap</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">SQL/MySQL</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">Cloud</span>
            <span class="badge m-1 p-2 fs-6 bg-light text-dark shadow-sm">Linux</span>
        </div>

        <a href="/Home/Projects" class="btn btn-lg px-5 py-2 btn-custom-gradient fw-semibold shadow mt-3">
            See My Work
        </a>
    </div>

</div>
