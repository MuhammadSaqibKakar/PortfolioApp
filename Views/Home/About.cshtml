@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">
    <div class="hero position-relative p-5" 
         style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
                border-radius: 30px;">

        <div class="row align-items-center">
            <!-- Image -->
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="~/images/myportfolioimage.jpg" 
                     class="rounded-circle shadow-lg img-fluid" 
                     style="border:4px solid white; width="450" ">
            </div>

            <!-- About Text -->
            <div class="col-md-8 text-white">
                <h2 class="fw-bold">About Me</h2>
                <p class="mt-3 fs-5">
                    I am a software engineer specializing in modern .NET development, web applications, and cloud technologies. 
                    I create professional, clean, and responsive projects. My goal is to combine elegant UI with robust functionality, 
                    focusing on <strong>Cloud</strong> and <strong>Linux</strong> environments.
                </p>

                <!-- Skills Badges -->
                <div class="mt-4 d-flex flex-wrap">
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">C#</span>
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">ASP.NET Core</span>
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">Entity Framework</span>
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">Cloud</span>
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">Linux</span>
                    <span class="badge bg-light text-dark m-2 p-2 fs-6 shadow-sm">SQL/MySQL</span>
                </div>

                <!-- Projects Button -->
                <div class="mt-4">
                    <a href="/Home/Projects" 
                       class="btn btn-custom-gradient btn-lg px-5 py-3 fw-semibold shadow">
                        See My Projects
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-custom-gradient {
        background: linear-gradient(135deg, #4a368d 0%, #3308f4 100%);
        border: none;
        border-radius: 50px;
        color: #f8f8f8;
        transition: all 0.3s ease-in-out;
        letter-spacing: 0.5px;
    }

    .btn-custom-gradient:hover {
        background: linear-gradient(135deg, #ffffff 0%, #1293ca 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(255, 154, 158, 0.4);
        color: #000 !important;
    }
</style>
