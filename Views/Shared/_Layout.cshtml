<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Portfolio</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" />
<style>
body { background-color: #f9f9f9; font-family: 'Segoe UI', sans-serif; }
.navbar { background-color: #343a40 !important; }
.navbar-brand, .nav-link { color: #f8f9fa !important; }
.nav-link:hover { color: #0d6efd !important; }
.hero { background: linear-gradient(to right, #6a11cb, #2575fc); color: white; padding: 100px 0; text-align: center; }
.hero h1 { font-size: 3rem; font-weight: 700; }
.hero p { font-size: 1.3rem; }
.card { transition: transform 0.3s; }
.card:hover { transform: translateY(-10px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
.btn-custom { border-radius: 50px; padding: 10px 25px; }
.footer { background-color: #343a40; color: white; padding: 20px 0; text-align: center; }
.badge-custom { background-color: #0d6efd; }
img.showcase-img { border-radius: 15px; transition: transform 0.3s; }
img.showcase-img:hover { transform: scale(1.05); }
</style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
<div class="container">
<a class="navbar-brand" href="/">Portfolio</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
<span class="navbar-toggler-icon"></span>
</button>
<div class="collapse navbar-collapse" id="navbarNav">
<ul class="navbar-nav ms-auto">
<li class="nav-item"><a class="nav-link" href="/">Home</a></li>
<li class="nav-item"><a class="nav-link" href="/Home/About">About</a></li>
<li class="nav-item"><a class="nav-link" href="/Home/Projects">Projects</a></li>
<li class="nav-item"><a class="nav-link" href="/Home/Certificates">Certificates</a></li>
<li class="nav-item"><a class="nav-link" href="/Home/Experiences">Experiences</a></li>
</ul>
</div>
</div>
</nav>


<div class="container mt-4">
@RenderBody()
</div>


<footer class="footer mt-5">
<p>© 2025 Saqib. All Rights Reserved.</p>
</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>